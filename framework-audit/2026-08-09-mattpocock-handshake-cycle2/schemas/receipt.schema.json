{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://luca.local/schemas/harness-issued-receipt-v1.json",
  "title": "Harness-issued child-agent receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "issuer",
    "harness",
    "run_id",
    "nonce",
    "parent_session_id",
    "child_session_id",
    "role",
    "target_commit",
    "input_sha256",
    "output_sha256",
    "started_at",
    "finished_at",
    "expires_at",
    "status",
    "source_log_path",
    "source_log_sha256",
    "agent_definition_sha256",
    "native_spawn_event_id",
    "event_chain_sha256",
    "signing_key_fingerprint",
    "signature_ed25519"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "issuer": { "const": "luca-agent-launcher" },
    "harness": { "enum": ["claude", "codex"] },
    "run_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{7,127}$" },
    "nonce": { "type": "string", "pattern": "^[0-9a-f]{32,128}$" },
    "parent_session_id": { "type": "string", "minLength": 4 },
    "child_session_id": { "type": "string", "minLength": 4 },
    "role": { "enum": ["plan-agent", "work-agent", "oracle", "quality-gate"] },
    "target_commit": { "$ref": "#/definitions/sha1" },
    "input_sha256": { "$ref": "#/definitions/sha256" },
    "output_sha256": { "$ref": "#/definitions/sha256" },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "status": { "enum": ["DONE", "BLOCKED", "NEEDS_CONTEXT", "FAILED"] },
    "source_log_path": { "type": "string", "minLength": 1 },
    "source_log_sha256": { "$ref": "#/definitions/sha256" },
    "agent_definition_sha256": { "$ref": "#/definitions/sha256" },
    "native_spawn_event_id": { "type": "string", "minLength": 4 },
    "event_chain_sha256": { "$ref": "#/definitions/sha256" },
    "signing_key_fingerprint": { "$ref": "#/definitions/sha256" },
    "signature_ed25519": { "type": "string", "pattern": "^[A-Za-z0-9+/]+={0,2}$" }
  },
  "definitions": {
    "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
