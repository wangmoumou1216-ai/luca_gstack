+def lock_timeout():
+    timeout = float(os.environ.get('_STATE_LOCK_TIMEOUT_SECONDS', '5'))
+    if not math.isfinite(timeout) or not 0 < timeout <= 60:
+        raise ValueError('_STATE_LOCK_TIMEOUT_SECONDS must be finite and within (0, 60]')
+    return timeout
