+    def __exit__(self, *args):
+        results = []
+        for process, call in zip(self.processes, self.calls):
+            if process.poll() is None:
+                process.kill()
+            self.finish(process)
+            identity = self.root / '.probe' / (call['probe']['WF_PROBE_TAG'] + '.identity.json')
