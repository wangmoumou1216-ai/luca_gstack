+  ['fresh vote after change', /任何草稿改动.*新 hash.*冷审.*旧票/s],
+]) check(name, () => has(facet, pattern));
+check('ordinary WA DONE prerequisite retained', () => has(ordinary, /status == DONE → 继续/));
