      "adhoc": "explicit aligned design source; no forced PRD workflow",
      "recover": "explicit bound OD project; skip source compilation, page matching and generation"
    },
    "quality_gates": [
      "input_source_resolved_when_not_recover",
      "design_generation_packet_when_chain",
      "no_source_fact_drift",
      "high_confidence_page_recommendation_only",
      "reference_confirmed_or_none",
      "platform_user_confirmed",
      "external_design_system_not_overridden",
      "designsystem_bound_verified_when_delegated",
      "exact_tool_target_and_write_authority"
    ],
    "completion_gates": {
      "exported": [
        "same_source_body_and_reference_materials",
        "no_claim_of_external_import"
      ],
      "staged": [
        "od_daemon_reachable",
        "exact_project_readback",
        "brief_and_all_reference_bytes_match",
        "no_claim_of_generation"
      ],
      "recovered": [
        "bound_project_only",
        "actual_nonempty_prototype_recovered",
        "all_related_artifacts_recovered",
        "prototype_spec_written",
        "honest_traceability",
        "project_handoff_when_pinned"
      ]
    },
    "notes": "Brief在冻结前完成模板选择/语义适配，OD复用有效选择并在冻结后核验正式绑定/采用，不重做产品定义。未指定模板且无高置信匹配可reference=none；指定原件/未决冲突不能降级绕过。原始需求/原型先由Brief归一化，原型实际bytes可作不可变证据附件。页确认不代替工具写入权。用户在OD配置DS；仅委托时绑定验证。默认桌面端生成，headless显式opt-in，原请求最多重试1次后回同一staged项目桌面端。Claude Design只导出同包，不探测OD。EXPORTED/STAGED不是生成完成或节点DONE。"
  }
