+    const stat = lstatSync(from);
+    if (stat.isDirectory() && !stat.isSymbolicLink()) snapshotDrift(from, to, rel, changed);
+    else if (!fileBytes(from).equals(fileBytes(to, true))) changed.push(rel);
+  }
+}
+function keys(value, expected) {
