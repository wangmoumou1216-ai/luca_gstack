+  if (!stat.isDirectory() || stat.isSymbolicLink() || realpathSync(path) !== path
+      || stat.uid !== process.getuid() || (stat.mode & 0o077)) throw new Error(`unsafe directory: ${path}`);
+}
+function snapshotDrift(source, snapshot, label, changed) {
