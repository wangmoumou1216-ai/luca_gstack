#!/bin/sh
# Agent-context commit gate. Validate the complete staged index snapshot, never the mutable worktree.

MSG_FILE="$1"
[ -f "$MSG_FILE" ] || exit 0

SNAPSHOT=$(mktemp -d "${TMPDIR:-/tmp}/agent-context-index.XXXXXX") || exit 1
cleanup() {
  node -e 'require("node:fs").rmSync(process.argv[1], {recursive:true, force:true})' "$SNAPSHOT"
}
trap cleanup EXIT HUP INT TERM

git checkout-index --all --prefix="$SNAPSHOT/" || {
  printf '[commit-msg] unable to export staged index for agent-context validation.\n' >&2
  exit 1
}

(cd "$SNAPSHOT" && python3 scripts/build-agent-context.py check >/dev/null) || {
  printf '[commit-msg] generated agent context is stale; run: python3 scripts/build-agent-context.py sync\n' >&2
  exit 1
}
(cd "$SNAPSHOT" && node scripts/check-agent-context.mjs >/dev/null) || {
  printf '[commit-msg] K1-K10, pointer, discovery, Static Fallback, or model contradiction gate failed.\n' >&2
  exit 1
}

exit 0
