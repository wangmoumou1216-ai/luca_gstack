#!/usr/bin/env bash
set -euo pipefail

if [ -z "${GIT_CLOSEOUT_LOCAL_DESCRIPTOR:-}" ] || [ -z "${GIT_CLOSEOUT_LOCAL_PATCH:-}" ]; then
  echo "GIT_LOCAL_CLOSEOUT_REQUIRED missing exact descriptor/patch; prepare and verify a local closeout before commit" >&2
  exit 1
fi

repo_root=$(git rev-parse --show-toplevel)
node "$repo_root/scripts/git-closeout.mjs" verify-local \
  --repo "$repo_root" \
  --patch "$GIT_CLOSEOUT_LOCAL_PATCH" \
  --descriptor "$GIT_CLOSEOUT_LOCAL_DESCRIPTOR"
