{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://luca-gstack.local/schemas/correction-ticket.schema.json",
  "title": "Correction ticket",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "verifier_registry",
    "ticket_id",
    "session_id",
    "event_id",
    "prompt_sha256",
    "prompt_signal",
    "nonce",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": "correction-ticket-v1" },
    "verifier_registry": { "const": "correction-verifiers-v1" },
    "ticket_id": { "type": "string", "pattern": "^ct-[a-f0-9]{64}$" },
    "session_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,36}$" },
    "event_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "prompt_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "prompt_signal": { "enum": ["NO_EXPLICIT_CORRECTION", "EXPLICIT_CORRECTION"] },
    "nonce": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
