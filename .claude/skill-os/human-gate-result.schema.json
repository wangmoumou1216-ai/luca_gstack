{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://luca-gstack.local/schemas/human-gate-result.schema.json",
  "title": "Human gate result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result_id",
    "binding_id",
    "binding_sha256",
    "proposal_id",
    "proposal_sha256",
    "gate",
    "harness",
    "session_id",
    "receipt_root",
    "secure_writer_sha256",
    "readback_sha256",
    "post_state_sha256",
    "observed_at"
  ],
  "properties": {
    "schema_version": { "const": "human-gate-result-v1" },
    "result_id": { "type": "string", "pattern": "^hgr-[a-f0-9]{64}$" },
    "binding_id": { "type": "string", "pattern": "^hgb-[a-f0-9]{64}$" },
    "binding_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "proposal_id": { "type": "string", "pattern": "^hgp-[a-f0-9]{64}$" },
    "proposal_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "gate": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$" },
    "harness": { "enum": ["claude", "codex"] },
    "session_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,36}$" },
    "receipt_root": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dev", "ino"],
      "properties": {
        "dev": { "type": "string", "pattern": "^(?:0|[1-9][0-9]*)$" },
        "ino": { "type": "string", "pattern": "^(?:0|[1-9][0-9]*)$" }
      }
    },
    "secure_writer_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "readback_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "post_state_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "observed_at": { "type": "string", "format": "date-time" }
  }
}
