{
  "env": {
    "MEMORY_ROOT": "/Users/luca/Desktop/luca_gstack",
    "ROUTE_GUARD_HEAVY_SKILLS": "muse-loop-orchestrate"
  },
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch",
      "Bash",
      "Read",
      "Write"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/session-restore.mjs\" 2>> /tmp/luca-gstack-hooks.log || true"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/route-guard.mjs\" 2>> /tmp/luca-gstack-hooks.log || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Write|Edit|MultiEdit|NotebookEdit|Read|Grep|Glob|Bash)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/project-scope-guard.mjs\" 2>> /tmp/luca-gstack-hooks.log || true"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/controlled-change-guard.mjs\" 2>> /tmp/luca-gstack-hooks.log; c=$?; if [ \"$c\" = \"2\" ]; then exit 2; fi; if [ \"$c\" != \"0\" ]; then node \"${CLAUDE_PROJECT_DIR:-.}/scripts/controlled-change.mjs\" hook-failure-decision 2>> /tmp/luca-gstack-hooks.log; exit $?; fi; exit 0"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Write|Edit|MultiEdit|NotebookEdit|Bash|Task|Agent|WebFetch|WebSearch|mcp__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/post-edit.mjs\" 2>> /tmp/luca-gstack-hooks.log || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/session-sync.mjs\" 2>> /tmp/luca-gstack-hooks.log || true"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/session-end.mjs\" 2>> /tmp/luca-gstack-hooks.log || true"
          }
        ]
      }
    ]
  }
}
